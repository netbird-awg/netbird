#!/bin/sh

set -x

APP=/Applications/NetBird-AWG.app
AGENT=/usr/local/bin/netibird-awg
LOG_FILE=/var/log/netbird/client_post_install.log

mkdir -p /var/log/netbird/
mkdir -p /usr/local/bin/

{
    echo "Installing NetBird-AWG..."

    if test -d "$APP"; then
        echo "NetBird-AWG app copied successfully."
    else
        echo "NetBird-AWG app could not be copied to the Applications folder."
        exit 1
    fi

    ln -fs "$APP/Contents/MacOS/netibird-awg" "$AGENT"
    if test -f "$AGENT"; then
        echo "NetBird-AWG binary linked successfully."
    else
        echo "NetBird-AWG could not create symlink in /usr/local/bin"
        exit 1
    fi

    "$AGENT" service install || true
    "$AGENT" service start || true

    console_user=$(stat -f%Su /dev/console 2>/dev/null)
    case "$console_user" in
        ""|root|loginwindow|_mbsetupuser)
            echo "No active GUI user session (console user: '${console_user:-none}'); skipping UI launch."
            ;;
        *)
            uid=$(id -u "$console_user" 2>/dev/null)
            if [ -z "$uid" ]; then
                echo "Could not resolve uid for console user '$console_user'; skipping UI launch."
            else
                echo "Launching NetBird-AWG UI as console user $console_user (uid $uid)."
                if ! launchctl asuser "$uid" sudo -u "$console_user" -H open "$APP"; then
                    echo "Failed to launch NetBird-AWG UI; it can be opened later."
                fi
            fi
            ;;
    esac

    echo "Finished NetBird-AWG installation successfully"
    exit 0 # all good
} > "$LOG_FILE" 2>&1
