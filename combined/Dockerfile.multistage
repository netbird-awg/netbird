FROM golang:1.25.12-bookworm@sha256:ea341baa9bd5ba6784f6d7161ace70544349a6242d54d34a0fbfd2c4d51c9d58 AS builder
WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev git && rm -rf /var/lib/apt/lists/*

COPY go.mod go.sum ./
COPY . .

# Build with version info from git (matching goreleaser ldflags).
# Let go build download only the modules used by the combined server. Downloading
# the complete root module graph also pulls client-only dependencies into CI.
# BuildKit cache mounts still keep server modules and compiled packages reusable.
ARG NETBIRD_VERSION=development
ARG NETBIRD_COMMIT=unknown
ARG SOURCE_DATE_EPOCH=0
ARG GOPROXY=https://proxy.golang.org,direct
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    BUILD_DATE="$(date -u -d "@${SOURCE_DATE_EPOCH}" +%Y-%m-%dT%H:%M:%SZ)" && \
    attempt=1 && \
    while :; do \
      if CGO_ENABLED=1 GOOS=linux GOPROXY="${GOPROXY}" go build -trimpath -buildvcs=false \
        -ldflags="-s -w \
        -X github.com/netbirdio/netbird/version.version=${NETBIRD_VERSION} \
        -X main.commit=${NETBIRD_COMMIT} \
        -X main.date=${BUILD_DATE} \
        -X main.builtBy=docker" \
        -o netbird-server ./combined; then \
        break; \
      fi; \
      if [ "$attempt" -ge 3 ]; then \
        exit 1; \
      fi; \
      attempt=$((attempt + 1)); \
      echo "go build download failed; retrying (${attempt}/3)" >&2; \
      sleep 2; \
    done

FROM ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --system --gid 10001 netbird && \
    useradd --system --uid 10001 --gid 10001 --home-dir /var/lib/netbird --shell /usr/sbin/nologin netbird && \
    install -d -o netbird -g netbird /var/lib/netbird
ENV HOME=/var/lib/netbird
VOLUME ["/var/lib/netbird"]
USER 10001:10001
ENTRYPOINT [ "/go/bin/netbird-server" ]
CMD ["--config", "/etc/netbird/config.yaml"]
COPY --from=builder /app/netbird-server /go/bin/netbird-server
